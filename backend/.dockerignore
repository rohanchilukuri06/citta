# Docker Ignore File for CittaAI
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
.pytest_cache/
node_modules/
.git/
.gitignore
tests/
test_reports/
*.log
.vscode/
.idea/
*.zip
*.tar.gz
dist/
build/
.next/
coverage/

# Ignore frontend except content.js asset
frontend/*
!frontend/src
frontend/src/*
!frontend/src/data
frontend/src/data/*
!frontend/src/data/content.js

# Runtime data with visitor conversations/contact details, and dev-only folders
*.db-wal
*.db-shm
*.db-journal
logs/
scratch/
evaluation/scratch/
data/semantic_index_cache/
knowledge/runtime/*.bak*
.venv/
venv/
